# --- AI providers (set at least one) ---
ANTHROPIC_API_KEY=
NANOGPT_API_KEY=
GOOGLE_API_KEY=            # Gemini (and Google Maps if that API is enabled on the key)
JARVIS_LLM_PROVIDER=anthropic   # anthropic | nanogpt | gemini

# --- Server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# --- Optional plugin keys (everything can also be set in the Settings / Plugins tabs) ---
OPENWEATHER_API_KEY=       # optional; Open-Meteo is used for free when empty
GOOGLE_MAPS_API_KEY=       # commute; falls back to GOOGLE_API_KEY
GOOGLE_OAUTH_CLIENT_FILE=  # path to OAuth client JSON for Calendar + Gmail
TODOIST_API_TOKEN=
TRACK17_API_KEY=           # package tracking (17track)
AVIATIONSTACK_API_KEY=     # flight status
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
HOME_ASSISTANT_URL=        # e.g. http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
ELEVENLABS_API_KEY=        # optional cloud TTS
PIPER_MODEL_PATH=          # path to a Piper .onnx voice for local TTS
