NANOGPT_API_KEY=your-nanogpt-key-here
NANOGPT_MODEL=chatgpt-4o-latest
APP_PASSWORD=pick-a-strong-password
# Optional: Google Gemini models (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Voice for spoken replies (via NanoGPT). Cheap: Kokoro-82m + bm_george / bm_lewis / bm_daniel.
# Most realistic: TTS_MODEL=Elevenlabs-Turbo-V2.5 with an ElevenLabs voice name, e.g. TTS_VOICE=Brian
TTS_MODEL=Kokoro-82m
TTS_VOICE=bm_george
